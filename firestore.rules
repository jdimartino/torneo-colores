rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // ============================================
    // FUNCIONES DE ROL (torneo-colores)
    // ============================================


    function isAuthenticated() {
      return request.auth != null;
    }


    function isActiveUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }


    function isMaster() {
      return isActiveUser() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'MASTER';
    }


    function isFull() {
      return isActiveUser() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'FULL';
    }


    function isMarcadores() {
      return isActiveUser() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'MARCADORES';
    }


    function isMarcadoresWritingResults() {
      return isMarcadores() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'set1_a', 'set1_b', 'set2_a', 'set2_b',
            'tiebreak1_a', 'tiebreak1_b', 'tiebreak2_a', 'tiebreak2_b',
            'supertiebreak_a', 'supertiebreak_b',
            'games_a', 'games_b',
            'ganador_equipo_id', 'estado', 'borrador',
            'fecha_resultado', 'puntos_aplicados'
          ]);
    }


    function isLegacyAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/config/admin) &&
        request.auth.uid in get(/databases/$(database)/documents/config/admin).data.adminUids;
    }


    function isAdmin() {
      return isLegacyAdmin() || isMaster() || isFull();
    }


    // ============================================
    // USUARIOS (torneo-colores)
    // ============================================


    match /usuarios/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isMaster();
      allow write: if isMaster();


      allow update: if isMaster() && (
        (request.auth.uid == userId ? resource.data.rol == 'MASTER' : true) &&
        (request.auth.uid == userId ? request.resource.data.activo == true : true)
      );
    }


    // ============================================
    // CONFIG (COMPARTIDA — 3 apps distintas usan esta colección)
    // ============================================


    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        || docId == 'torneosAmericano_activeTournament'
        || docId == 'tennisScore_teams';
    }


    // ============================================
    // TORNEOS COLORES (con roles)
    // ============================================


    match /torneosColores/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();


      match /equipos/{equipoId} {
        allow read: if true;
        allow write: if isAdmin();
      }


      match /jugadores/{jugadorId} {
        allow read: if true;
        allow write: if isAdmin();
      }


      match /jornadas/{jornadaId} {
        allow read: if true;
        allow write: if isAdmin();


        match /enfrentamientos/{enfId} {
          allow read: if true;
          allow write: if isAdmin();
        }


        match /partidos/{partidoId} {
          allow read: if true;
          allow write: if isAdmin();
          allow update: if isMarcadoresWritingResults();
        }
      }


      match /categorias/{categoriaId} {
        allow read: if true;
        allow write: if isAdmin();
      }


      match /semifinales/{semiId} {
        allow read: if true;
        allow write: if isAdmin();


        match /partidos/{partidoId} {
          allow read: if true;
          allow write: if isAdmin();
          allow update: if isMarcadoresWritingResults();
        }
      }


      match /finales/{finalId} {
        allow read: if true;
        allow write: if isAdmin();


        match /partidos/{partidoId} {
          allow read: if true;
          allow write: if isAdmin();
          allow update: if isMarcadoresWritingResults();
        }
      }


      match /finanzas/{movimientoId} {
        allow read: if true;
        allow write: if isAdmin();
      }


      match /configuracion/{configId} {
        allow read: if true;
        allow write: if isAdmin();
      }


      match /enviosEmail/{envioId} {
        allow read: if false;
        allow write: if false;
      }
    }


    match /emailStats/{docId} {
      allow read: if false;
      allow write: if false;
    }


    // ============================================
    // TORNEOS AMERICANO (abierto, sin Auth — igual que siempre)
    // ============================================


    match /torneosAmericano/{tournamentId} {
      allow read, write: if true;


      match /{subcollection}/{document=**} {
        allow read, write: if true;
      }
    }


    // ============================================
    // TENNIS STATS (requiere estar autenticado, sin chequeo de rol —
    // igual que su regla original)
    // ============================================


    match /statsPlayers/{playerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }


    match /statsMatches/{matchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }


    match /statsClubs/{clubId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }


    match /statsLeagues/{leagueId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }


    // ============================================
    // TENNIS SCORE (abierto, sin Auth — igual que siempre)
    // ============================================


    match /jornadasScore/{jornadaId} {
      allow read, write: if true;
    }


    // ============================================
    // TODO LO DEMÁS: denegado por defecto
    // ============================================


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
